{
  "extends": "@ansa/config/tsconfig.base.json",
  "compilerOptions": {
    // The base targets CommonJS on Node 10 resolution, which is right for the API and
    // impossible for Next: it needs ES modules, bundler resolution and the DOM. These are
    // the only overrides, so every strictness flag in the base still applies here —
    // `noUncheckedIndexedAccess` included, which is why array access in this app is
    // checked rather than asserted.
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "target": "ES2023",

    "noEmit": true,
    "allowJs": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // Decorators are a NestJS concern and nothing here uses them.
    "experimentalDecorators": false,
    "emitDecoratorMetadata": false,
    "declaration": false,
    "declarationMap": false,

    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
