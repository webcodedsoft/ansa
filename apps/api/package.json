{
  "name": "@ansa/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "openapi": "nest build && node dist/api/openapi/emit.js",
