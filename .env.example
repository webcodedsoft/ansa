# Copy to .env. Never commit the real file.

PORT=3000

# The externally reachable origin. In local dev this is the ngrok HTTPS URL, with no
# trailing slash. The carrier signs the URL it called, so a mismatch here rejects every
# webhook with 403.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Twilio Console > Account Info. Used to verify the X-Twilio-Signature header.
TWILIO_AUTH_TOKEN=

# Set to false ONLY to exercise the webhook locally with curl. Leaving it false in front
# of a public tunnel lets anyone on the internet originate calls against this service.
TWILIO_VERIFY_SIGNATURES=true

# ElevenLabs. Required — the app refuses to boot without them, because an agent that
# cannot speak has nothing to offer a caller.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Point at a local stub to exercise the call path without spending credits.
# ELEVENLABS_BASE_URL=http://127.0.0.1:3399

# Postgres. Two roles on purpose.
#
# The app connects as ansa_app, which has rolbypassrls = false. Supabase's default
# `postgres` role has BYPASSRLS, which defeats FORCE ROW LEVEL SECURITY entirely — every
# policy stays visible in pg_policies while enforcing nothing, and every tenant sees
# every other tenant's calls. Never point DATABASE_URL at it.
#
# 6543 is the transaction-mode pooler. SET LOCAL survives it because it is scoped to a
# transaction; session state would not.
DATABASE_URL=postgresql://ansa_app.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://ansa_app.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Migrations only. Owns the schema, and creating roles/policies requires it.
MIGRATION_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
