# Copy to .env. Never commit the real file.

PORT=3000

# The externally reachable origin. In local dev this is the ngrok HTTPS URL, with no
# trailing slash. The carrier signs the URL it called, so a mismatch here rejects every
# webhook with 403.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Twilio Console > Account Info. Used to verify the X-Twilio-Signature header.
TWILIO_AUTH_TOKEN=

# Set to false ONLY to exercise the webhook locally with curl. Leaving it false in front
# of a public tunnel lets anyone on the internet originate calls against this service.
TWILIO_VERIFY_SIGNATURES=true

# ElevenLabs. Required — the app refuses to boot without them, because an agent that
# cannot speak has nothing to offer a caller.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Optional. Point at a local stub to exercise the call path without spending credits.
# ELEVENLABS_BASE_URL=http://127.0.0.1:3399

# How the voice is driven. Every one of these is optional and, left unset, is not sent at
# all — ElevenLabs merges what it receives over the voice's own stored settings, so a
# default here would quietly replace what somebody tuned in their console.
#
# ELEVENLABS_MODEL_ID defaults to eleven_flash_v2_5 (~75ms). Set it to
# eleven_turbo_v2_5 only to compare; never eleven_v3 or eleven_multilingual_v2, both of
# which are far too slow for a live call.
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY_BOOST=0.75
# ELEVENLABS_STYLE=0.35
# ELEVENLABS_SPEAKER_BOOST=true
# Fallback pace for agents that publish none; the agent's own always wins. 0.7-1.2, and
# outside that the vendor refuses the request, which on a call is a silent turn.
# ELEVENLABS_SPEED=0.95

# Small noises — "mm-hm", "right" — while the caller is still talking. Off by default,
# and the default is the point: their absence is part of why calls feel like walkie-talkie
# exchanges, but if the gate around them is wrong the agent reacts to its own noise, which
# is the barge-in defect all over again. Turn it on once somebody has heard it on a phone.
# BACKCHANNEL=true

# Which vendor speaks: elevenlabs (default) or cartesia. A real A/B rather than a legacy
# switch — neither has won. Refused at boot if it is anything else, and cartesia without a
# key is refused at boot too, because discovering that on the first turn of a real call
# means a caller hears the recovery line.
#
# Switching means republishing the agent's voice. Voice ids are per-vendor and both are
# uuids, so nothing catches a mismatch by inspection; the wrong one is refused on the first
# turn. The readiness check reports "unchecked" rather than guessing while cartesia speaks.
#
# tts_first_byte carries the provider name, so GET /api/v1/calls/latency separates the two.
# TTS_PROVIDER=cartesia
# CARTESIA_API_KEY=
# CARTESIA_MODEL_ID=sonic-3
# CARTESIA_SPEED=0.95
# CARTESIA_BASE_URL=http://127.0.0.1:3398

# Postgres. Two roles on purpose.
#
# The app connects as ansa_app, which has rolbypassrls = false. Supabase's default
# `postgres` role has BYPASSRLS, which defeats FORCE ROW LEVEL SECURITY entirely — every
# policy stays visible in pg_policies while enforcing nothing, and every organization sees
# every other organization's calls. Never point DATABASE_URL at it.
#
# 6543 is the transaction-mode pooler. SET LOCAL survives it because it is scoped to a
# transaction; session state would not.
DATABASE_URL=postgresql://ansa_app.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://ansa_app.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Migrations only. Owns the schema, and creating roles/policies requires it.
MIGRATION_DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# OpenAI: realtime transcription, turn detection, and the LLM.
OPENAI_API_KEY=
# gpt-4o-transcribe, and this line used to say the opposite.
#
# The mini variant is about 120ms faster to a usable transcript, which is why it was the
# recommendation here — and a later A/B on the same voice and line settled it the other
# way. Mini rendered "policy" as apology, penalty and course, which is close to fatal for
# an insurance agent, while the larger model got it right twice in one sentence. The 120ms
# costs nothing measurable end to end, because the other stages vary by more than that.
#
# gpt-live-transcribe rejects mu-law and cannot be used here at all.
TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Silence before a turn is committed. Measured tradeoff: at 500ms a long utterance was
# split at a natural thinking pause (false end-of-turn), and about half the ~1.0s
# end-of-speech-to-transcript latency is this floor. Lower is faster and interrupts more.
VAD_SILENCE_MS=500

# Which listen provider. "openai" (default) or "deepgram". Both stay available so they
# can be compared on real calls. Deepgram Flux is the only one of the two offering
# keyterm boosting (R4.1.3) or per-word confidence (R4.1.5).
LISTEN_PROVIDER=openai
# Deepgram authenticates with "Token", NOT "Bearer" — Bearer returns 401.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=flux-general-en
# api.eu.deepgram.com is nearer to Lagos and worth measuring against the US host.
DEEPGRAM_HOST=api.deepgram.com
DEEPGRAM_EOT_THRESHOLD=0.8
DEEPGRAM_EOT_TIMEOUT_MS=3000

# The key that opens a organization's stored credentials (R5.2.1). 32 bytes, base64:
#
#   openssl rand -base64 32
#
# Optional, and unset is a working configuration: a organization tool that needs a credential
# is then not registered at all, and the agent says it cannot check rather than making an
# anonymous request to somebody's customer API. Tools with no credential still work.
#
# Never put this in the database. The sealed values live there; if the key did too, a
# database dump would be a credential leak and the encryption would be decoration. The
# same value must be given to tools/organization/config.mjs when sealing.
TOOL_CREDENTIAL_KEY=

# What a call costs, as this deployment is billed for it (Slice 8).
#
# Usage is measured from the event log and is true whatever anyone charges; these are the
# prices, which are a contract with a vendor rather than a property of the software and
# differ between two deployments of the same build. That is why there are no defaults:
# unset means the viewer shows minutes and characters with no money beside them, which is
# the honest answer. It never means free.
#
# Per-minute for the line and for each listen provider, per thousand characters for the
# voice. LISTEN rates are `provider=amount` pairs so a composite call — two connections,
# two bills — can be attributed to each vendor separately (R4.1.9).
#
# There is deliberately no rate for the model. A vendor bills tokens, the completion
# stream does not report them, and a per-character price would be a made-up figure.
COST_CURRENCY=
COST_TELEPHONY_PER_MINUTE=
COST_LISTEN_PER_MINUTE=
COST_TTS_PER_1K_CHARACTERS=
